# ──────────────────────────────────────────────────────────────────────────
# Junubân — environment variables (copy to .env and fill in real values)
# Never commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────

# ---- Shared / general -------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Swagger docs (/api/docs) are mounted automatically when NODE_ENV isn't
# "production". Set this to "true" to force them on in a production
# deployment (e.g. an internal-only staging environment) — leave unset
# otherwise, since the docs page exposes every route/DTO with no auth
# of its own.
ENABLE_SWAGGER=false
# Same value as API_URL, but exposed to the browser bundle (Next.js only
# inlines NEXT_PUBLIC_* vars client-side). Used by the Cart, which talks
# to the API directly from the browser so the API's Set-Cookie responses
# (session/guest-cart cookies) are handled natively by the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Database (apps/api) ----------------------------------------------
DATABASE_URL="postgresql://junuban:junuban_dev_password@localhost:5432/junuban?schema=public"

# ---- Redis (apps/api, apps/worker) -------------------------------------
REDIS_URL="redis://localhost:6379"

# ---- Object storage — S3-compatible (MinIO locally) ---------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="junuban-media"
S3_ACCESS_KEY_ID="junuban"
S3_SECRET_ACCESS_KEY="junuban_dev_password"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL="http://localhost:9000/junuban-media"

# ---- Customer auth: mobile + OTP ---------------------------------------
# HMAC key used to hash OTP codes and session tokens before storing them.
# Generate with: openssl rand -hex 32
OTP_HASH_SECRET="replace-with-a-64-char-hex-secret"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT_PER_HOUR=5

SESSION_COOKIE_NAME=junuban_session
SESSION_RENEWAL_WINDOW_DAYS=7
SESSION_ABSOLUTE_MAX_DAYS=30
SESSION_HASH_SECRET="replace-with-a-64-char-hex-secret"

# ---- Guest cart -----------------------------------------------------------
GUEST_CART_COOKIE_NAME=junuban_guest_cart
GUEST_CART_MAX_AGE_DAYS=30

# SMS provider used to deliver OTP codes. Kept behind a provider
# abstraction (see apps/api/src/auth/otp/sms-provider.ts). "kavenegar" and
# "ghasedak" are real, implemented Iranian SMS gateway integrations —
# both use their respective OTP/Verify-template endpoints, not a raw SMS
# send, so a matching template must be created in that provider's panel
# first (see the SMS_KAVENEGAR_TEMPLATE / SMS_GHASEDAK_TEMPLATE comments
# below for the exact placeholder each expects).
SMS_PROVIDER=console   # console | kavenegar | ghasedak
# Required (and validated at startup) when SMS_PROVIDER is kavenegar or ghasedak.
SMS_PROVIDER_API_KEY=
# Kavenegar Verify Lookup template name. Create this template in the
# Kavenegar panel with a single token placeholder (%token%). Defaults to
# "verify" if unset.
SMS_KAVENEGAR_TEMPLATE=verify
# Ghasedak Verify template name. Create this template in the Ghasedak
# panel with a single parameter (param1). Defaults to "otp-code" if unset.
SMS_GHASEDAK_TEMPLATE=otp-code

# ---- Admin auth (email + password, Argon2id) ----------------------------
ADMIN_SESSION_COOKIE_NAME=junuban_admin_session
ADMIN_SESSION_TTL_HOURS=12

# Used ONLY by `npm run prisma:seed:admin -w apps/api` (apps/api/prisma/
# seed-admin.ts) to bootstrap the single initial OWNER account. Safe to
# run repeatedly — it does nothing if an account with this email already
# exists, and never overwrites an existing password. Set these as real
# secrets in your deploy environment (never commit real values); after
# the first successful run you can remove ADMIN_PASSWORD from the
# environment if you prefer not to leave it sitting there.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Payment providers ---------------------------------------------------
# See apps/api/src/payments/PaymentProvider for the abstraction.
# "stub" is a documented sandbox implementation for local development only.
PAYMENT_PROVIDER=stub   # stub | zarinpal | ...
PAYMENT_PROVIDER_MERCHANT_ID=
PAYMENT_CALLBACK_BASE_URL="http://localhost:4000/api/v1/payments/callback"

# Card-to-card and Sheba (IBAN) destination info shown to the customer
# (manual confirmation flow) is now configured from the admin panel
# (Settings → Payment — see AdminSettingsService / SiteSettings in the
# Prisma schema), not environment variables. No env var replaces
# CARD_TO_CARD_NUMBER / CARD_TO_CARD_HOLDER_NAME / SHEBA_IBAN /
# SHEBA_HOLDER_NAME, which existed here previously.

# ---- Shipping -------------------------------------------------------------
SHIPPING_FLAT_RATE_TOMAN=350000
SHIPPING_FREE_THRESHOLD_TOMAN=2000000
SHIPPING_FREE_ENABLED=true

# ---- Inventory reservation ------------------------------------------------
INVENTORY_RESERVATION_TTL_MINUTES=15

# ---- Rate limiting ----------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
